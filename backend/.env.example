SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=120
ALLOW_PUBLIC_REGISTRATION=false
SECURE_TRANSPORT_REQUIRED=true
TRUST_X_FORWARDED_PROTO=false

MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_SERVER=localhost
